# s3-poller 配置示例
# 用法：java -jar s3-poller.jar --config poller.yaml

s3:
  # S3 兼容存储地址（MinIO / OSS / COS 等）；留空则使用官方 AWS
  endpoint: http://127.0.0.1:9000
  region: us-east-1
  # 是否 path-style 访问：true=桶名在 URL 路径中（MinIO 等无 DNS 解析的本地服务）；
  # false=桶名作为子域名 virtual-hosted-style（默认，AWS / 腾讯云 COS 要求）
  pathStyleAccess: true
  bucket: my-bucket
  # 只扫描该前缀下的对象，可为空
  prefix: logs/
  accessKeyId: minioadmin
  secretAccessKey: minioadmin
  # 每次 ListObjects 的分页大小
  fetchPageSize: 100
  # 请求重试参数（指数退避 + 抖动）
  retryBackoff:
    delayMs: 100
    maxDelayMs: 20000
    maxRetries: 10

poll:
  # 一轮扫描完后的休眠秒数；有积压时可配置 0 连续扫描
  intervalSeconds: 10
  # 文件名过滤模板，如 {{topic}}-{{partition}}-{{start_offset}}；为空则匹配所有对象
  filePattern: ""
  # 对象外层压缩：none / gzip / snappy / zstd
  # none=自动探测对象流文件头（gzip/zstd 命中才解压，否则按非压缩读取）
  compressionType: none
  # 从该 key 开始消费；为空则从断点或桶首开始
  nativeStartKey: ""
  # 已消费对象 key 的去重缓冲大小，重启后由断点文件预填
  ringBufferSize: 1000
  # 单轮轮询最多输出的记录数，达到后先持久化断点再继续；0 表示不限制
  maxPollRecords: 500
  # 对象下载临时目录；为空使用系统临时目录。大对象建议配置专用目录，启动时会清理其中残留
  downloadDir: ""

parse:
  # 输入格式：avro / parquet / jsonl / bytes / bytes-line
  # bytes-line=按行切分原始字节透传（不解析、不解码，消费端按实际编码解码）
  inputFormat: jsonl
  # bytes 格式的切块大小；bytes-line 格式的单行最大字节数，超长行跳过并告警
  maxBufferSize: 4096

output:
  # 输出方式：file=本地文件（测试） / kafka=发送到 Kafka（生产）
  type: file
  file:
    directory: ./out
    # per-object=每个 S3 对象一个文件；append=全部追加到单一文件
    mode: per-object
  kafka:
    bootstrapServers: localhost:9092
    # 固定目标 topic；为空则使用 filePattern 中提取的 topic
    topic: target-topic
    acks: all
    security:
      protocol: PLAINTEXT
      username: ""
      password: ""

offsets:
  # 断点存储类型：file=本地 JSON 文件 / mysql=MySQL 8.0 表
  type: file
  # type=file 时使用；进程重启后从该文件记录的 key 之后继续扫描，
  # 同时用其中的已消费对象列表预填去重缓冲
  file: ./offsets.json
  # type=mysql 时使用（下表字段按需替换）
  mysql:
    # JDBC 连接串，如 jdbc:mysql://127.0.0.1:3306/s3_poller?useSSL=false
    jdbcUrl: ""
    username: ""
    password: ""
    # 断点表名，只允许字母/数字/下划线，启动时自动创建
    table: s3_offset
    # 已消费对象窗口大小；为空则取 poll.ringBufferSize
    maxProcessedKeys: 1000
